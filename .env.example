# Local backend development
APP_ENV=development
AI_PROVIDER=ollama

# Local AI provider
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_KEEP_ALIVE=15m

# Optional when testing Gemini locally; Render production uses AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local MongoDB. For Render, replace with your MongoDB Atlas SRV connection string.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=placement_assistant
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_TIMEOUT_MS=10000

# Local frontend origins; set the deployed frontend origin on Render.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local-only fallback. Set a generated secret in production.
JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
NUM_QUESTIONS=6
